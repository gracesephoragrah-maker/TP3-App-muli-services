**Commandes exécutées :**
```bash
cat > docker-compose.yml <<'EOF'
services:
  api:
    build: ./api
    ports: ["5000:5000"]
    environment:
      NOM: "GRAH GRACE DIVINE SEPHORA"
      DATABASE_URL: postgresql://app:app_mdp@db:5432/app
      S3_ENDPOINT: http://minio:9000
      S3_ACCESS_KEY: tp3admin
      S3_SECRET_KEY: tp3-secret-123
